{
  "name": "@project-saturday/web",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --configLoader runner --host 0.0.0.0",
    "build": "corepack pnpm run typecheck && vite build --configLoader runner",
    "assets:pwa": "pwa-assets-generator --config pwa-assets.config.ts",
    "preview": "vite preview --configLoader runner --host 0.0.0.0",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.test.json && tsc --noEmit -p tsconfig.node.json",
    "lint": "eslint . --max-warnings 0",
    "test": "vitest run"
  },
  "dependencies": {
    "@project-saturday/game-content": "workspace:*",
    "@project-saturday/game-core": "workspace:*",
    "i18next": "26.4.0",
    "i18next-icu": "2.4.4",
    "idb": "8.0.3",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-i18next": "17.0.12",
    "workbox-window": "7.4.1"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.6",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.5",
    "@vite-pwa/assets-generator": "1.0.2",
    "@vitejs/plugin-react": "6.1.1",
    "fake-indexeddb": "6.2.5",
    "jsdom": "30.0.1",
    "vite": "8.2.2",
    "vite-plugin-pwa": "1.3.0"
  }
}
