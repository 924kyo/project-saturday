{
  "name": "@project-saturday/testkit",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "source": "./src/index.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "report:development": "corepack pnpm --filter @project-saturday/game-content build && tsc -p tsconfig.build.json && node dist/report-cli.js",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.test.json",
    "test": "vitest run --config vitest.config.ts"
  },
  "dependencies": {
    "@project-saturday/game-content": "workspace:*",
    "@project-saturday/game-core": "workspace:*"
  }
}
